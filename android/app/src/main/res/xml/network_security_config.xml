<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The lightning relay runs on the LAN with TLS disabled, so it speaks
         plain ws:// (cleartext). Android blocks cleartext by default on API 28+,
         so permit it only for the relay host. Keep this host in sync with
         LightningService.defaultRelayUrl. Once the relay is fronted by TLS (wss://),
         this exception can be removed. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.134</domain>
    </domain-config>
</network-security-config>
